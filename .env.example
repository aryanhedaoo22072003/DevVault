MONGODB_URI='mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DevVault-final-db?retryWrites=true&w=majority'
MONGODB_DB=DevVault-final-db
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
# Server-only. Obtain this from the authenticated Clerk dashboard/session.
DEVVAULT_OWNER_CLERK_USER_ID=user_your_owner_id_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
# Optional for localhost reconciliation; required when testing or deploying the webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here
# Development-only private storage. Must not point inside public/.
PRIVATE_STORAGE_ROOT=.devvault-private
MAX_PRIVATE_ASSET_BYTES=52428800

# Optional Stage 2 sandbox. Run/Submit stay disabled until all values validate and Judge0 passes health checks.
JUDGE0_ENDPOINT=https://your-private-judge0.example.com
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=your_server_only_token
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_JAVASCRIPT_LANGUAGE_ID=63

