MONGODB_URI='mongodb+srv://<username>:<password>@<cluster>.mongodb.net/DevVault-final-db?retryWrites=true&w=majority'
MONGODB_DB=DevVault-final-db
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
# Server-only. Obtain this from the authenticated Clerk dashboard/session.
DEVVAULT_OWNER_CLERK_USER_ID=user_your_owner_id_here
# Exact application origin, with no path or trailing slash. Production must use HTTPS.
# This is also the Clerk authorized-party origin and Stripe Checkout return origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
# Optional for localhost reconciliation; required when testing or deploying the webhook.
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here
# Development-only private storage. Must not point inside public/.
PRIVATE_STORAGE_ROOT=.devvault-private
MAX_PRIVATE_ASSET_BYTES=52428800
# Use local-private for development. Set s3-private only after configuring and validating the private bucket.
PRIVATE_STORAGE_PROVIDER=local-private
# Optional S3-compatible private object storage. Keep credentials server-only; prefer workload identity when available.
S3_PRIVATE_ENDPOINT=https://s3-compatible-endpoint.example.com
S3_PRIVATE_REGION=your-region
S3_PRIVATE_BUCKET=your-private-bucket
S3_PRIVATE_PREFIX=devvault-assets
S3_PRIVATE_FORCE_PATH_STYLE=false
S3_PRIVATE_ACCESS_KEY_ID=
S3_PRIVATE_SECRET_ACCESS_KEY=

# Operator-only content import variables. Do not add these to the Vercel application
# unless intentionally running the importer from a trusted one-off environment.
CONTENT_IMPORT_MONGODB_URI='mongodb+srv://<import-user>:<password>@<cluster>.mongodb.net/DevVault-production?retryWrites=true&w=majority'
CONTENT_IMPORT_MONGODB_DB=DevVault-production
CONTENT_IMPORT_ENVIRONMENT=staging

# Optional Stage 2 sandbox. Run/Submit stay disabled until all values validate and Judge0 passes health checks.
JUDGE0_ENDPOINT=https://your-private-judge0.example.com
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=your_server_only_token
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_JAVASCRIPT_LANGUAGE_ID=63

